{
  "name": "nvchad-themes",
  "displayName": "NvChad Themes",
  "description": "All 97 NvChad base46 themes, dark and light, with NvChad's exact syntax colors on a clean, flat workbench. Every theme comes in a frameless and a bordered style.",
  "version": "1.2.4",
  "publisher": "sabbirahamedmaruf",
  "author": {
    "name": "Sabbir Ahamed Maruf"
  },
  "license": "GPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "https://github.com/SabbirAhamedMaruf/Nvchad-Themes-Vscode-Vscodium.git"
  },
  "homepage": "https://github.com/SabbirAhamedMaruf/Nvchad-Themes-Vscode-Vscodium",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "nvchad",
    "base46",
    "neovim",
    "theme",
    "color-theme"
  ],
  "scripts": {
    "extract": "node scripts/sync.mjs",
    "color-keys": "node scripts/vscode-color-keys.mjs",
    "build": "node scripts/build.mjs",
